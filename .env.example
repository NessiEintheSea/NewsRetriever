# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# NOTE: This app summarises with Anthropic's Claude (not OpenAI/GPT).
# The task spec used OPENAI_* names; the equivalents here are ANTHROPIC_*.

# ── LLM (required) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model used for filtering / summarising / story judgement.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ── Embeddings (Anthropic has no embedding API) ──────────────────────────────
# local  = dependency-free lexical embedder (default; no key needed)
# openai = real semantic embeddings for better story clustering
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Full-text extraction (better summaries/diffs; more requests) ─────────────
FETCH_FULL_TEXT=false
FULL_TEXT_MAX_CHARS=4000
FULL_TEXT_TIMEOUT=10

# ── Delivery ─────────────────────────────────────────────────────────────────
# Which channel to deliver to: discord (default) or slack.
NOTIFIER=discord
DISCORD_WEBHOOK_URL=
# Only needed when NOTIFIER=slack (kept for backwards compatibility):
SLACK_WEBHOOK_URL=

# ── Persistence ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/news.db

# ── Story / update behaviour ─────────────────────────────────────────────────
DELIVER_MINOR_UPDATES=false
STORY_LOOKBACK_DAYS=30
SIMILARITY_THRESHOLD=0.82
SIMILARITY_CANDIDATE_LIMIT=10

# ── Digest volume & diversity ────────────────────────────────────────────────
DIGEST_MAX_ITEMS=7
MAX_ITEMS_PER_SOURCE=2
MAX_ITEMS_PER_CATEGORY=2
MAX_UPDATE_ITEMS=3
REQUIRE_PRIMARY_SOURCE=true

# ── Ranking weights (should sum to ~1.0) ─────────────────────────────────────
WEIGHT_RELEVANCE=0.30
WEIGHT_NOVELTY=0.25
WEIGHT_IMPORTANCE=0.20
WEIGHT_SOURCE_QUALITY=0.15
WEIGHT_RECENCY=0.10

# ── Fetch volume (existing knobs) ────────────────────────────────────────────
GENRES=japan,world,tech,ai,crypto
ARTICLES_PER_GENRE=5
MIN_FETCH=10
FETCH_RATIO=0.30
